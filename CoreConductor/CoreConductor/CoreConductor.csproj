<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>Core_Conductor</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageId>ContactCI.Maestro.CoreConductor</PackageId>
        <Company>Contact CI</Company>
        <Authors>Contact CI</Authors>
        <Product>Maestro</Product>
        <Description>A C# interface for ContactCI Maestro haptic gloves</Description>
        <PackageProjectUrl>https://contactci.co</PackageProjectUrl>
        <PackageTags>ContactCI;Maestro;VR;XR;AR;haptics</PackageTags>
    </PropertyGroup>

    <!-- Brings the native DLLs in for IDE builds. build.ps1 (and so CI) sets
         SkipLibcorePackage: it builds the DLLs itself, and the packed
         dependency on libcore is written from the release version instead. -->
    <ItemGroup Condition="'$(SkipLibcorePackage)' != 'true'">
      <PackageReference Include="ContactCI.Maestro.libcore" Version="[2.2.30, 2.4.0)"/>
    </ItemGroup>

</Project>
