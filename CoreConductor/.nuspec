<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ContactCI.Maestro.CoreConductor</id>
    <version>1.0.0</version>
    <authors>Contact CI</authors>
    <projectUrl>https://contactci.co/</projectUrl>
    <description>A C# interface for ContactCI Maestro haptic gloves</description>
    <tags>ContactCI Maestro VR XR AR haptics</tags>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="ContactCI.Maestro.libcore" version="2.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
    <!-- A readme.txt to display when the package is installed -->
    <files>
        <file src="build/release-mingw/libcci.dll" target="runtimes/win-x64/native" />
        <file src="build/release-mingw/libccic.dll" target="runtimes/win-x64/native" />
       <!-- <file src="icon.png" target="" /> -->
    </files>
</package>